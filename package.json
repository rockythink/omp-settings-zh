{
  "name": "omp-settings-zh",
  "version": "18.6.2",
  "description": "Chinese settings and slash-command autocomplete localization, plus a bilingual Stats dashboard for official Oh My Pi — no fork or binary patch.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/rockythink/omp-settings-zh#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rockythink/omp-settings-zh.git"
  },
  "bugs": {
    "url": "https://github.com/rockythink/omp-settings-zh/issues"
  },
  "keywords": [
    "oh-my-pi",
    "omp",
    "i18n",
    "localization",
    "chinese",
    "typescript",
    "developer-tools"
  ],
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/images"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "coverage:check": "bun run scripts/check-coverage.ts",
    "drift:check": "bun run scripts/diff-upstream.ts",
    "commands:check": "bun run scripts/check-slash-commands.ts",
    "smoke": "bun run scripts/smoke-extension.ts",
    "check": "bun run typecheck && bun test && bun run coverage:check && bun run drift:check && bun run commands:check && bun run smoke"
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=18.6.0 <19",
    "@oh-my-pi/pi-utils": ">=18.6.0 <19"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.6.0",
    "@oh-my-pi/pi-utils": "18.6.0",
    "@types/bun": "latest",
    "typescript": "5.9.2"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
